{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "log:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/cache/images" },
        { "path": "$APPDATA/cache/images/**" }
      ]
    }
  ]
}
